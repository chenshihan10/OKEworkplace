# OKEworkplace 示例配置
# 使用方式：复制为 .env 后填入自己的值。
# 开发模式放在 backend/.env；打包版放在 _internal/.env（与 .env.example 同目录）。
# 真实 .env 不要提交到仓库，也不要随产物分发。

# OKX 行情接口（只读即可，不需要交易权限）
OKE_BASE_URL=https://www.okx.com
OKE_API_KEY=your_api_key_here
OKE_SECRET_KEY=your_secret_key_here

# 本地代理（如 Hiddify）；留空则直连。注意本机 DNS 被污染时直连通常不可用。
HTTP_PROXY=http://127.0.0.1:12334
HTTPS_PROXY=http://127.0.0.1:12334

# 行情刷新与信号
POLL_INTERVAL_SECONDS=5
SIGNAL_COOLDOWN_MINUTES=30
MONITOR_TIMEFRAMES=5m,15m,1h,4h

# 关键价位（示例，可留空）
BTC_LEVELS=59000,60000,62000,63000
ETH_LEVELS=1700,1730,1750,1780,1800,1830

# 历史数据（可选）
DATA_STORAGE_STRATEGY=memory
KEEP_HISTORY_RECORDS=100

# ── 实盘只读（OKX 私有 REST，仅签名 GET；未启用时不注册任务、不请求） ──
# 建议使用独立只读子账户，不授予交易与提现权限；Key 只放本机 .env。
OKE_PRIVATE_READ_ENABLED=false
# 留空则继承 OKE_BASE_URL；账户注册地区使用其它域名时在这里覆盖
OKE_PRIVATE_READ_BASE_URL=
OKE_PRIVATE_READ_API_KEY=
OKE_PRIVATE_READ_SECRET_KEY=
OKE_PRIVATE_READ_PASSPHRASE=

# 刷新节奏（秒）与快照落库间隔（分钟）
OKE_ACCOUNT_POLL_SECONDS=30
OKE_ACCOUNT_FILLS_POLL_SECONDS=120
OKE_ACCOUNT_CONFIG_POLL_SECONDS=600
OKE_ACCOUNT_SNAPSHOT_MINUTES=5
# 保留策略：快照 30 天、成交 365 天；首次回看 7 天
OKE_ACCOUNT_RETENTION_DAYS=30
OKE_ACCOUNT_FILLS_RETENTION_DAYS=365
OKE_ACCOUNT_FILLS_INITIAL_DAYS=7
