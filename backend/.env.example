# 生产部署请在平台环境变量中配置以下项，不要上传 .env 文件
OKE_BASE_URL=https://www.okx.com
OKE_API_KEY=your_api_key_here
OKE_SECRET_KEY=your_secret_key_here
POLL_INTERVAL_SECONDS=15
SIGNAL_COOLDOWN_MINUTES=30
MONITOR_TIMEFRAMES=5m,15m,1h,4h
BTC_LEVELS=59000,60000,62000,63000
ETH_LEVELS=1700,1730,1750,1780,1800,1830

# 代理仅在本地需要时设置，生产环境请勿写死本机地址（留空即直连）
# HTTP_PROXY=http://127.0.0.1:12334
# HTTPS_PROXY=http://127.0.0.1:12334

# 生产环境设为 false，禁用 /api/shutdown 进程退出接口
OKE_ENABLE_SHUTDOWN=false

# v2.2 方向抖动控制
SIGNAL_BUFFER_SIZE=12
SIGNAL_HYSTERESIS_LOW=35
SIGNAL_HYSTERESIS_HIGH=55
SIGNAL_CONFIRM_COUNT=3
SIGNAL_FLIP_COUNT=4
SIGNAL_COOLDOWN_MINUTES=5
